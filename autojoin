-- ==
local CONFIG = {
    MODE = "REJOIN", -- "REJOIN" hoặc "SERVERHOP"
    
    MSG_LOAD_TITLE = "SCRIPT BY ZERO x TAIIKU",
    MSG_LOAD_TEXT  = "TikTok : @TAIIKU037",
    
    MSG_HOP_TITLE  = "HOP SERVER",
    MSG_HOP_TEXT   = "DANG CHUYEN SERVER...",
    
    NOTIFY_DURATION = 4
}
-- ==

local StarterGui = game:GetService("StarterGui")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function showNotification(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = CONFIG.NOTIFY_DURATION,
            Icon = "rbxassetid://6031071057"
        })
    end)
end

local function handleServerChange()
    showNotification(CONFIG.MSG_HOP_TITLE, CONFIG.MSG_HOP_TEXT)
    task.wait(1)
    
    local placeId = game.PlaceId
    local jobId = game.JobId

    if CONFIG.MODE == "REJOIN" then
        if #jobId > 0 then
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    else
        pcall(function()
            local serversApi = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/0?sortOrder=Asc&limit=100"
            local rawData = game:HttpGet(serversApi)
            local body = HttpService:JSONDecode(rawData)
            
            if body and body.data then
                for _, server in pairs(body.data) do
                    if server.playing < server.maxPlayers and server.id ~= jobId then
                        TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                        return
                    end
                end
            end
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end
end

local function doClick(btn)
    if not btn then return end
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Down) end)
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.MouseButton1Up) end)
        pcall(function() firesignal(btn.Activated) end)
    end
    if getconnections then
        pcall(function()
            for _, conn in pairs(getconnections(btn.MouseButton1Click)) do pcall(function() conn:Fire() end) end
            for _, conn in pairs(getconnections(btn.Activated)) do pcall(function() conn:Fire() end) end
            for _, conn in pairs(getconnections(btn.MouseButton1Down)) do pcall(function() conn:Fire() end) end
        end)
    end
end

-- TIẾN TRÌNH CHÍNH
task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    showNotification(CONFIG.MSG_LOAD_TITLE, CONFIG.MSG_LOAD_TEXT)
    print(">>> AUTO JOIN & HOP ACTIVATED <<<")

    local notInGameTimer = 0
    local downedTimer = 0

    while true do
        task.wait(0.2)

        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        -- 1. KIỂM TRA MẶT BẰNG MENU & BẤM JOIN GAME
        local isAtMenu = false
        if playerGui then
            local menu = playerGui:FindFirstChild("Menu")
            if menu and menu.Enabled then
                isAtMenu = true
                
                -- Tìm và Click nút Join Game
                pcall(function()
                    local joinBtn = menu.Views.Default.MainMenu.Center.Buttons.Frame.B:FindFirstChild("ImageButton")
                    if joinBtn then
                        doClick(joinBtn)
                    end
                end)
            end
        end

        -- 2. ĐÁNH GIÁ TRẠNG THÁI CHƠI
        -- NGUYÊN LÝ: Nếu KHÔNG CÓ HRP (chưa spawn vào map) HOẶC ĐANG Ở MENU -> Tính là chưa vào trận
        if isAtMenu or not hrp then
            notInGameTimer = notInGameTimer + 0.2
            downedTimer = 0

            -- Nếu đứng ở Menu / Bị NO LIVES / Không spawn được quá 4.5 giây -> HOP SERVER NGAY
            if notInGameTimer >= 4.5 then
                print("Kẹt Menu / Không Spawn / Hết mạng -> Tiến hành Hop Server!")
                handleServerChange()
                break
            end
        else
            -- Đã vào trận thành công
            notInGameTimer = 0 

            -- Kiểm tra trạng thái bị gục (Downed)
            local isDowned = char:GetAttribute("Downed")
            if isDowned then
                downedTimer = downedTimer + 0.2
                if downedTimer >= 4 then
                    print("Bị gục quá 4s -> Hop Server!")
                    handleServerChange()
                    break
                end
            else
                downedTimer = 0
            end
        end
    end
end)
