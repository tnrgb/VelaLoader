-- == CONFIG ==
local CONFIG = {
    MODE = "REJOIN", -- "REJOIN" hoặc "SERVERHOP"
    
    MSG_LOAD_TITLE = "SCRIPT BY ZERO x TAIIKU",
    MSG_LOAD_TEXT  = "TikTok : @TAIIKU037",
    
    MSG_JOIN_TITLE = "KAITUN EVADE SUMMER EVENT!",
    MSG_JOIN_TEXT  = "zeroyeuem",
    
    MSG_HOP_TITLE  = "HOP SERVER",
    MSG_HOP_TEXT   = "Chuyển Server trong 1s...",
    
    NOTIFY_DURATION = 4
}
-- ==

local StarterGui = game:GetService("StarterGui")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function showNotification(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = CONFIG.NOTIFY_DURATION,
            Icon = "rbxassetid://6031071057"
        })
    end)
end

local function handleServerChange()
    showNotification(CONFIG.MSG_HOP_TITLE, CONFIG.MSG_HOP_TEXT)
    task.wait(1)
    
    local placeId = game.PlaceId
    local jobId = game.JobId

    if CONFIG.MODE == "REJOIN" then
        if #jobId > 0 then
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    else
        pcall(function()
            local serversApi = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/0?sortOrder=Asc&limit=100"
            local rawData = game:HttpGet(serversApi)
            local body = HttpService:JSONDecode(rawData)
            
            if body and body.data then
                for _, server in pairs(body.data) do
                    if server.playing < server.maxPlayers and server.id ~= jobId then
                        TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                        return
                    end
                end
            end
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end
end

local function doClick(joinBtn)
    if firesignal then
        pcall(function() firesignal(joinBtn.MouseButton1Down) end)
        pcall(function() firesignal(joinBtn.MouseButton1Click) end)
        pcall(function() firesignal(joinBtn.MouseButton1Up) end)
        pcall(function() firesignal(joinBtn.Activated) end)
    end

    if getconnections then
        pcall(function()
            for _, conn in pairs(getconnections(joinBtn.MouseButton1Click)) do pcall(function() conn:Fire() end) end
            for _, conn in pairs(getconnections(joinBtn.Activated)) do pcall(function() conn:Fire() end) end
            for _, conn in pairs(getconnections(joinBtn.MouseButton1Down)) do pcall(function() conn:Fire() end) end
        end)
    end
end

-- Tìm nút Join an toàn (Quét sâu)
local function getJoinButton(playerGui)
    local menu = playerGui:FindFirstChild("Menu")
    if not menu then return nil end
    
    local success, btn = pcall(function()
        return menu.Views.Default.MainMenu.Center.Buttons.Frame.B.ImageButton
    end)
    
    if success and btn then
        return btn, menu
    end
    return nil, menu
end

-- TIẾN TRÌNH CHÍNH
task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    
    showNotification(CONFIG.MSG_LOAD_TITLE, CONFIG.MSG_LOAD_TEXT)
    print("Bắt đầu Auto Join...")

    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 15)
    if not playerGui then
        handleServerChange()
        return
    end
    
    local joinBtn = nil
    local menu = nil
    local retries = 0

    -- Thử quét tìm nút Join trong 15 giây
    repeat
        joinBtn, menu = getJoinButton(playerGui)
        if not joinBtn then
            task.wait(1)
            retries = retries + 1
        end
    until joinBtn or retries >= 15

    -- Nếu không thấy nút Join (Lỗi GUI hoặc kẹt Menu) -> Rejoin ngay
    if not joinBtn then
        print("[AutoJoin] Không tìm thấy nút Join -> Đang Rejoin...")
        handleServerChange()
        return
    end

    -- Thực hiện bấm nút Join
    showNotification(CONFIG.MSG_JOIN_TITLE, CONFIG.MSG_JOIN_TEXT)
    
    local joinedSuccess = false
    for i = 1, 6 do
        print("Đang bấm Join lần " .. i .. "...")
        doClick(joinBtn)
        task.wait(1)
        
        -- Kiểm tra xem đã vào game thành công chưa (Menu ẩn hoặc bị xóa)
        if menu and (not menu.Parent or not menu.Enabled or not menu:IsDescendantOf(playerGui)) then
            joinedSuccess = true
            print(">>> VÀO GAME THÀNH CÔNG! <<<")
            break
        end
    end

    -- Nếu đã vào game: Bảo vệ nhân vật không bị chết
    if joinedSuccess then
        task.spawn(function()
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart", 10)
            if hrp then
                -- Đưa nhân vật lên cao ngay lập tức để tránh bị Nextbot cắn chết
                hrp.CFrame = hrp.CFrame + Vector3.new(0, 200, 0)
                hrp.Anchored = true
            end
        end)
    else
        -- Nếu bấm 6 lần vẫn ở Menu -> Bị treo/kẹt mạng -> Rejoin ngay
        print("[AutoJoin] Kẹt ở Menu -> Đang tiến hành Rejoin/Hop Server...")
        handleServerChange()
    end
end)
