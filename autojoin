-- == CONFIG ==
local CONFIG = {
    MODE = "REJOIN", -- "REJOIN" hoặc "SERVERHOP"
    CHECK_INTERVAL = 0.5, -- Tần suất kiểm tra UI (0.5s/lần)
    
    MSG_LOAD_TITLE = "SCRIPT BY ZERO x TAIIKU",
    MSG_LOAD_TEXT  = "TikTok : @TAIIKU037",
    
    MSG_HOP_TITLE  = "HOP SERVER",
    MSG_HOP_TEXT   = "Phát hiện kẹt/chết -> Đang đổi Server...",
    
    NOTIFY_DURATION = 3
}
-- ==

local StarterGui = game:GetService("StarterGui")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function showNotification(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = CONFIG.NOTIFY_DURATION,
            Icon = "rbxassetid://6031071057"
        })
    end)
end

local function handleServerChange()
    showNotification(CONFIG.MSG_HOP_TITLE, CONFIG.MSG_HOP_TEXT)
    task.wait(1)
    
    local placeId = game.PlaceId
    local jobId = game.JobId

    if CONFIG.MODE == "REJOIN" then
        if #jobId > 0 then
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    else
        pcall(function()
            local serversApi = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/0?sortOrder=Asc&limit=100"
            local rawData = game:HttpGet(serversApi)
            local body = HttpService:JSONDecode(rawData)
            
            if body and body.data then
                for _, server in pairs(body.data) do
                    if server.playing < server.maxPlayers and server.id ~= jobId then
                        TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                        return
                    end
                end
            end
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end
end

local function doClick(joinBtn)
    if firesignal then
        pcall(function() firesignal(joinBtn.MouseButton1Down) end)
        pcall(function() firesignal(joinBtn.MouseButton1Click) end)
        pcall(function() firesignal(joinBtn.MouseButton1Up) end)
        pcall(function() firesignal(joinBtn.Activated) end)
    end

    if getconnections then
        pcall(function()
            for _, conn in pairs(getconnections(joinBtn.MouseButton1Click)) do pcall(function() conn:Fire() end) end
            for _, conn in pairs(getconnections(joinBtn.Activated)) do pcall(function() conn:Fire() end) end
            for _, conn in pairs(getconnections(joinBtn.MouseButton1Down)) do pcall(function() conn:Fire() end) end
        end)
    end
end

-- VÒNG LẶP GIÁM SÁT LIÊN TỤC (THEO DÕI NÚT JOIN & MÀN HÌNH ĐỎ)
task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    showNotification(CONFIG.MSG_LOAD_TITLE, CONFIG.MSG_LOAD_TEXT)

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    local downedTimer = 0
    local menuStuckTimer = 0

    while true do
        task.wait(CONFIG.CHECK_INTERVAL)

        ------------------------------------------------------------------------
        -- 1. GIÁM SÁT TÌNH TRẠNG BỊ GỤC (MÀN HÌNH ĐỎ / DOWNED)
        ------------------------------------------------------------------------
        local char = LocalPlayer.Character
        local isDowned = char and char:GetAttribute("Downed")

        if isDowned then
            downedTimer = downedTimer + CONFIG.CHECK_INTERVAL
            -- Nếu bị gục (màn hình viền đỏ) quá 5 giây mà không được cứu -> Rejoin/Hop ngay
            if downedTimer >= 5 then
                print("[AutoJoin] Phát hiện bị gục quá lâu -> Hop Server...")
                handleServerChange()
                break
            end
        else
            downedTimer = 0
        end

        ------------------------------------------------------------------------
        -- 2. THEO DÕI NÚT "JOIN GAME", "NO LIVES LEFT" VÀ MENU LIÊN TỤC
        ------------------------------------------------------------------------
        local menu = playerGui:FindFirstChild("Menu")
        if menu and menu.Enabled then
            -- Quét xem có nút B (nút Join mặc định) không
            local joinBtn = nil
            pcall(function()
                joinBtn = menu.Views.Default.MainMenu.Center.Buttons.Frame.B.ImageButton
            end)

            -- Quét toàn bộ Text trong Menu xem có chữ "JOIN GAME" hoặc "NO LIVES LEFT" không
            local foundNoLivesText = false
            for _, v in ipairs(menu:GetDescendants()) do
                if v:IsA("TextLabel") or v:IsA("TextButton") then
                    local txt = string.upper(v.Text)
                    if string.find(txt, "NO LIVES") or string.find(txt, "NO LIVES LEFT") then
                        foundNoLivesText = true
                    end
                end
            end

            -- NẾU HẾT MẠNG (NO LIVES LEFT) -> REJOIN NGAY LẬP TỨC!
            if foundNoLivesText then
                print("[AutoJoin] Phát hiện NO LIVES LEFT -> Hop Server ngay!")
                handleServerChange()
                break
            end

            -- NẾU CÓ NÚT JOIN -> TỰ BẤM NÚT
            if joinBtn and joinBtn.Visible then
                print("[AutoJoin] Tìm thấy nút JOIN GAME -> Đang tự động bấm...")
                doClick(joinBtn)
                menuStuckTimer = menuStuckTimer + CONFIG.CHECK_INTERVAL
            else
                menuStuckTimer = menuStuckTimer + CONFIG.CHECK_INTERVAL
            end

            -- Nếu kẹt ở Menu quá 12 giây mà không vào được trận -> Rejoin luôn
            if menuStuckTimer >= 12 then
                print("[AutoJoin] Kẹt ở Menu quá lâu -> Hop Server...")
                handleServerChange()
                break
            end
        else
            -- Nếu đã vào trận (Menu ẩn) -> Reset đếm kẹt
            menuStuckTimer = 0
        end
    end
end)
