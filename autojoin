-- ==
local CONFIG = {
    MODE = "REJOIN", -- "REJOIN"
    
    MSG_LOAD_TITLE = "SCRIPT BY ZERO x TAIIKU",
    MSG_LOAD_TEXT  = "TikTok : @TAIIKU037",
    
    MSG_JOIN_TITLE = "KAITUN EVADE SUMMER EVENT!",
    MSG_JOIN_TEXT  = "zeroyeuem",
    
    MSG_HOP_TITLE  = "HOP SEVER",
    MSG_HOP_TEXT   = "HOP SEVER IN 1S",
    
    NOTIFY_DURATION = 4
}
-- ==

local StarterGui = game:GetService("StarterGui")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function showNotification(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = CONFIG.NOTIFY_DURATION,
            Icon = "rbxassetid://6031071057"
        })
    end)
end

local function handleServerChange()
    showNotification(CONFIG.MSG_HOP_TITLE, CONFIG.MSG_HOP_TEXT)
    task.wait(1)
    
    local placeId = game.PlaceId
    local jobId = game.JobId

    if CONFIG.MODE == "REJOIN" then
        if #jobId > 0 then
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    else
        pcall(function()
            local serversApi = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/0?sortOrder=Asc&limit=100"
            local rawData = game:HttpGet(serversApi)
            local body = HttpService:JSONDecode(rawData)
            
            if body and body.data then
                for _, server in pairs(body.data) do
                    if server.playing < server.maxPlayers and server.id ~= jobId then
                        TeleportService:TeleportToPlaceInstance(placeId, server.id, LocalPlayer)
                        return
                    end
                end
            end
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end
end

--
local function doClick(joinBtn)
    if firesignal then
        pcall(function() firesignal(joinBtn.MouseButton1Down) end)
        pcall(function() firesignal(joinBtn.MouseButton1Click) end)
        pcall(function() firesignal(joinBtn.MouseButton1Up) end)
        pcall(function() firesignal(joinBtn.Activated) end)
    end

    if getconnections then
        for _, conn in pairs(getconnections(joinBtn.MouseButton1Click)) do pcall(function() conn:Fire() end) end
        for _, conn in pairs(getconnections(joinBtn.Activated)) do pcall(function() conn:Fire() end) end
        for _, conn in pairs(getconnections(joinBtn.MouseButton1Down)) do pcall(function() conn:Fire() end) end
    end
end

-- TIẾN TRÌNH CHÍNH (Đã sửa triệt để nhận diện nhầm UI)
task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    
    showNotification(CONFIG.MSG_LOAD_TITLE, CONFIG.MSG_LOAD_TEXT)
    print("Bắt đầu Auto Join...")

    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
    if not playerGui then return end

    local downedTimer = 0

    while true do
        task.wait(0.5)

        ------------------------------------------------------------------------
        -- 1. CHỈ REJOIN KHI BỊ GỤC (DOWNED) QUÁ 8 GIÂY
        ------------------------------------------------------------------------
        local char = LocalPlayer.Character
        local isDowned = char and char:GetAttribute("Downed")
        
        if isDowned then
            downedTimer = downedTimer + 0.5
            if downedTimer >= 8 then -- Đợi hẳn 8s nếu không được cứu mới Hop
                print("[AutoJoin] Bị gục quá 8s -> Tiến hành Hop Server...")
                handleServerChange()
                break
            end
        else
            downedTimer = 0
        end

        ------------------------------------------------------------------------
        -- 2. TỰ BẤM JOIN GAME KHI NÚT HIỂN THỊ
        ------------------------------------------------------------------------
        local menu = playerGui:FindFirstChild("Menu")
        if menu then
            local joinBtn = nil
            pcall(function()
                joinBtn = menu.Views.Default.MainMenu.Center.Buttons.Frame.B.ImageButton
            end)

            -- CHỈ BẤM KHI NÚT THỰC SỰ HIỆN TRÊN MÀN HÌNH (IsDescendantOf & Visible)
            if joinBtn and joinBtn:IsDescendantOf(playerGui) and joinBtn.Visible then
                -- Kiểm tra thêm nếu bảng NoLives đang đè lên nút
                local noLivesFrame = menu:FindFirstChild("NoLives", true)
                if noLivesFrame and noLivesFrame.Visible then
                    print("[AutoJoin] Phát hiện bảng NO LIVES đang hiện -> Hop Server!")
                    handleServerChange()
                    break
                else
                    -- Bấm nút Join liên tục
                    doClick(joinBtn)
                end
            end
        end
    end
end)
